<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for macOS. Install with (from the repo root):
  sed "s|@LANDROP_DIR@|$PWD|g" autostart/local.landrop.plist > ~/Library/LaunchAgents/local.landrop.plist
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.landrop.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.landrop</string>
  <key>ProgramArguments</key>
  <array>
    <string>@LANDROP_DIR@/.venv/bin/python</string>
    <string>@LANDROP_DIR@/server.py</string>
    <string>--log-file</string>
    <string>@LANDROP_DIR@/landrop.log</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@LANDROP_DIR@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardErrorPath</key>
  <string>@LANDROP_DIR@/landrop.log</string>
</dict>
</plist>
